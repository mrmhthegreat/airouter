new file mode 100644
index 0000000..14fb599
--- /dev/null
+++ b/pkg/router/embed_test.go
@@ -0,0 +1,109 @@
+package router
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"github.com/mrmhthegreat/airouter/pkg/types"
+)
+
+// embedServer answers POST /embeddings with one 2-number vector per input
+// (value = input length) and records the path.
+func embedServer(t *testing.T, status int, path *string) *httptest.Server {
+	s := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if path != nil {
+			*path = r.URL.Path
+		}
+		if status != 200 {
+			http.Error(w, "boom", status)
+			return
+		}
+		var body struct {
+			Input []string `json:"input"`
+		}
+		_ = json.NewDecoder(r.Body).Decode(&body)
+		type item struct {
+			Index     int       `json:"index"`
+			Embedding []float32 `json:"embedding"`
+		}
+		var out struct {
+			Data []item `json:"data"`
+		}
+		// answer in reverse order to prove the router restores input order via index
+		for i := len(body.Input) - 1; i >= 0; i-- {
+			out.Data = append(out.Data, item{Index: i, Embedding: []float32{float32(len(body.Input[i])), 1}})
+		}
+		_ = json.NewEncoder(w).Encode(out)
+	}))
+	t.Cleanup(s.Close)
+	return s
+}
+
+func embedMod(p *types.ProviderConfig) { p.Category = types.CategoryEmbed }
+
+func TestEmbedReturnsVectorsInOrder(t *testing.T) {
+	var path string
+	srv := embedServer(t, 200, &path)
+	r := newCapRouter(t, 100*time.Millisecond)
+	add(t, r, "emb", srv.URL, 1, 0, embedMod)
+	resp, err := r.Embed(context.Background(), types.EmbedRequest{Texts: []string{"a", "abc", "ab"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if path != "/embeddings" || len(resp.Vectors) != 3 || resp.Vectors[0][0] != 1 || resp.Vectors[1][0] != 3 || resp.Vectors[2][0] != 2 {
+		t.Fatalf("path=%q vectors=%v", path, resp.Vectors)
+	}
+	if resp.Provider != "emb" || resp.Own {
+		t.Fatalf("bad meta: %+v", resp)
+	}
+}
+
+func TestEmbedFailsOverAndNeedsProviders(t *testing.T) {
+	bad := embedServer(t, 500, nil)
+	good := embedServer(t, 200, nil)
+	r := newCapRouter(t, 100*time.Millisecond)
+	if _, err := r.Embed(context.Background(), types.EmbedRequest{Texts: []string{"x"}}); err == nil {
+		t.Fatal("no embedding providers should be an error")
+	}
+	add(t, r, "bad", bad.URL, 1, 0, embedMod)
+	add(t, r, "good", good.URL, 2, 0, embedMod)
+	resp, err := r.Embed(context.Background(), types.EmbedRequest{Texts: []string{"x"}})
+	if err != nil || resp.Provider != "good" || len(resp.Attempts) != 1 {
+		t.Fatalf("resp=%+v err=%v", resp, err)
+	}
+	if _, err := r.Embed(context.Background(), types.EmbedRequest{}); !errors.Is(err, types.ErrBadRequest) {
+		t.Fatalf("empty texts: %v", err)
+	}
+}
+
+// A pool-only cap that is used up blocks the shared pool for embeddings (and
+// speech), but the tenant's own embedding key keeps working.
+func TestEmbedPoolOnlyCap(t *testing.T) {
+	pool := embedServer(t, 200, nil)
+	own := embedServer(t, 200, nil)
+	r := newCapRouter(t, 100*time.Millisecond)
+	add(t, r, "pool", pool.URL, 1, 0, embedMod)
+	ctx := context.Background()
+	if _, _, err := r.CreateTenant(ctx, types.Tenant{ID: "acme", DailyRequestLimit: 1, PoolOnlyCap: true}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := r.Embed(ctx, types.EmbedRequest{TenantID: "acme", Texts: []string{"x"}}); err != nil {
+		t.Fatalf("first pool request: %v", err)
+	}
+	var tl *types.TenantLimitError
+	if _, err := r.Embed(ctx, types.EmbedRequest{TenantID: "acme", Texts: []string{"x"}}); !errors.As(err, &tl) {
+		t.Fatalf("pool cap used up should give TenantLimitError, got %v", err)
+	}
+	if _, err := r.AddTenantProvider(ctx, "acme", types.ProviderConfig{Name: "mine", Kind: "openai", BaseURL: own.URL, APIKey: "k", Model: "m", Category: types.CategoryEmbed, Priority: 1}); err != nil {
+		t.Fatal(err)
+	}
+	resp, err := r.Embed(ctx, types.EmbedRequest{TenantID: "acme", Texts: []string{"x"}})
+	if err != nil || !resp.Own {
+		t.Fatalf("own key should still answer: %+v %v", resp, err)
+	}
+}
diff --git a/pkg/router/isolation_test.go b/pkg/router/isolation_test.go
new file mode 100644
index 0000000..992563e
--- /dev/null
+++ b/pkg/router/isolation_test.go
@@ -0,0 +1,144 @@
+package router
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/mrmhthegreat/airouter/pkg/store"
+	"github.com/mrmhthegreat/airouter/pkg/types"
+)
+
+// Tenants hammer the router at the same time. Each has its own provider and key.
+// A tenant must only ever be served by its own provider, with its own key, and
+// must never be able to reach another tenant's provider, even by pinning its name.
+func TestConcurrentTenantIsolation(t *testing.T) {
+	const tenants, perTenant = 6, 40
+	type seen struct {
+		mu   sync.Mutex
+		keys map[string]int
+		hits atomic.Int64
+	}
+	var servers [tenants]*httptest.Server
+	var sn [tenants]*seen
+	for i := 0; i < tenants; i++ {
+		i := i
+		sn[i] = &seen{keys: map[string]int{}}
+		servers[i] = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			sn[i].hits.Add(1)
+			sn[i].mu.Lock()
+			sn[i].keys[r.Header.Get("Authorization")]++
+			sn[i].mu.Unlock()
+			_, _ = fmt.Fprintf(w, `{"choices":[{"message":{"content":"answer-from-%d"}}],"usage":{"total_tokens":3}}`, i)
+		}))
+		t.Cleanup(servers[i].Close)
+	}
+	var poolHits atomic.Int64
+	pool := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		poolHits.Add(1)
+		_, _ = w.Write([]byte(`{"choices":[{"message":{"content":"pool"}}],"usage":{"total_tokens":1}}`))
+	}))
+	t.Cleanup(pool.Close)
+
+	r, err := New(Options{Store: store.NewMemoryStore(), MaxWait: 10 * time.Second, TenantPolicy: TenantPolicy{AllowCustomBaseURL: true}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx := context.Background()
+	add(t, r, "shared-pool", pool.URL, 50, 0, nil)
+	for i := 0; i < tenants; i++ {
+		id := fmt.Sprintf("tenant%d", i)
+		if _, _, err := r.CreateTenant(ctx, types.Tenant{ID: id}); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := r.AddTenantProvider(ctx, id, types.ProviderConfig{Name: fmt.Sprintf("mine-%d", i), Kind: "openai",
+			BaseURL: servers[i].URL, APIKey: fmt.Sprintf("key-%d", i), Model: "m", Priority: 1, Workers: 8}); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	var wg sync.WaitGroup
+	var bad atomic.Int64
+	// A tenant's own model has at most 8 workers (maxTenantWorkers). Keep each
+	// tenant under that, or the extra requests would (correctly) spill over into
+	// the shared pool, which is a different behaviour from what is tested here.
+	var slots [tenants]chan struct{}
+	for i := range slots {
+		slots[i] = make(chan struct{}, 6)
+	}
+	for i := 0; i < tenants; i++ {
+		for k := 0; k < perTenant; k++ {
+			wg.Add(1)
+			go func(i int) {
+				defer wg.Done()
+				slots[i] <- struct{}{}
+				defer func() { <-slots[i] }()
+				resp, err := r.Generate(ctx, types.Request{TenantID: fmt.Sprintf("tenant%d", i), Prompt: "hi"})
+				if err != nil || resp.Text != fmt.Sprintf("answer-from-%d", i) || !resp.Own {
+					bad.Add(1)
+					t.Errorf("tenant%d got %v / %+v", i, err, resp)
+				}
+			}(i)
+		}
+	}
+	wg.Wait()
+	if bad.Load() > 0 {
+		t.FailNow()
+	}
+	for i := 0; i < tenants; i++ {
+		if got := sn[i].hits.Load(); got != perTenant {
+			t.Errorf("provider %d got %d requests, want %d", i, got, perTenant)
+		}
+		for k := range sn[i].keys {
+			if k != fmt.Sprintf("Bearer key-%d", i) {
+				t.Errorf("provider %d was called with someone else's key %q", i, k)
+			}
+		}
+	}
+	if poolHits.Load() != 0 {
+		t.Errorf("shared pool was used %d times although every tenant has its own key", poolHits.Load())
+	}
+
+	// tenant0 tries to use tenant1's provider by naming it
+	before := sn[1].hits.Load()
+	resp, err := r.Generate(ctx, types.Request{TenantID: "tenant0", Prompt: "hi", Provider: "mine-1"})
+	if err == nil && strings.Contains(resp.Text, "answer-from-1") {
+		t.Fatal("tenant0 reached tenant1's provider by name")
+	}
+	if sn[1].hits.Load() != before {
+		t.Fatal("tenant1's provider was called on behalf of tenant0")
+	}
+	// ...and cannot see, change or delete it through the self-service calls
+	own0, shared0 := r.ListTenantProviders(ctx, "tenant0")
+	for _, p := range own0 {
+		if p.Name == "mine-1" {
+			t.Fatal("tenant0 sees tenant1's provider in its own list")
+		}
+	}
+	for _, p := range shared0 {
+		if p.Name == "mine-1" {
+			t.Fatal("tenant1's private provider is listed as shared")
+		}
+	}
+	var other int64
+	for _, p := range r.Status(ctx, "tenant1") {
+		if p.Name == "mine-1" {
+			other = p.ID
+		}
+	}
+	if other == 0 {
+		t.Fatal("test setup: provider id not found")
+	}
+	if err := r.DeleteTenantProvider(ctx, "tenant0", other); err == nil {
+		t.Fatal("tenant0 deleted tenant1's provider")
+	}
+	if err := r.SetTenantProviderKey(ctx, "tenant0", other, "stolen"); err == nil {
+		t.Fatal("tenant0 replaced tenant1's key")
+	}
+}
