+// UpdateTenantCap changes a tenant's daily request cap at any time (for
+// example when its plan changes). poolOnly makes the cap count only requests
+// served by the shared pool, so the tenant's own provider keys are free. The
+// change applies to the next request. Operator-side call.
+func (r *Router) UpdateTenantCap(ctx context.Context, id string, dailyLimit int, poolOnly, disabled bool) (*types.Tenant, error) {
+	if dailyLimit < 0 {
+		return nil, errors.New("daily limit cannot be negative")
+	}
+	if err := r.store.UpdateTenantCap(ctx, id, dailyLimit, poolOnly, disabled); err != nil {
+		if errors.Is(err, types.ErrNotFound) {
+			return nil, types.ErrUnknownTenant
+		}
+		return nil, err
+	}
+	return r.store.TenantByID(ctx, id)
+}
diff --git a/pkg/router/audio_fix_test.go b/pkg/router/audio_fix_test.go
new file mode 100644
index 0000000..765f75a
--- /dev/null
+++ b/pkg/router/audio_fix_test.go
@@ -0,0 +1,166 @@
+package router
+
+import (
+	"bytes"
+	"context"
+	"encoding/base64"
+	"encoding/binary"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"os/exec"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/mrmhthegreat/airouter/pkg/types"
+)
+
+func haveFFmpeg() bool { _, err := exec.LookPath("ffmpeg"); return err == nil }
+
+// rawPCM makes n samples of silence-ish 16-bit mono PCM (no header).
+func rawPCM(n int) []byte {
+	b := make([]byte, n*2)
+	for i := 0; i < n; i++ {
+		binary.LittleEndian.PutUint16(b[i*2:], uint16(int16((i%100)*200-10000)))
+	}
+	return b
+}
+
+// Groq's TTS only returns WAV. When the caller asks for mp3/opus the router
+// must ask Groq for WAV (never "mp3") and convert afterwards.
+func TestGroqIsAskedForWAVNotMP3(t *testing.T) {
+	var gotFormat atomic.Value
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		var body map[string]any
+		_ = json.NewDecoder(r.Body).Decode(&body)
+		gotFormat.Store(body["response_format"])
+		if body["response_format"] != "wav" { // what the real Groq does
+			http.Error(w, `{"error":"response_format must be wav"}`, 400)
+			return
+		}
+		w.Header().Set("Content-Type", "audio/wav")
+		_, _ = w.Write(pcmToWAV(rawPCM(24000), 24000, 1, 16))
+	}))
+	t.Cleanup(srv.Close)
+	r := newRouter(t, nil)
+	add(t, r, "groq-tts", srv.URL+"/api.groq.com/openai/v1", 1, 0, func(p *types.ProviderConfig) { p.Category = types.CategoryTTS })
+
+	for _, want := range []string{"mp3", "opus"} {
+		resp, err := r.Speak(context.Background(), types.SpeakRequest{Text: "hello", Format: want})
+		if err != nil {
+			t.Fatalf("%s: %v", want, err)
+		}
+		if gotFormat.Load() != "wav" {
+			t.Fatalf("Groq was sent response_format=%v, want wav", gotFormat.Load())
+		}
+		if haveFFmpeg() && resp.Format != want {
+			t.Fatalf("want converted %s, got %s (%s)", want, resp.Format, resp.ContentType)
+		}
+		if !haveFFmpeg() && resp.Format != "wav" {
+			t.Fatalf("without ffmpeg the router must fall back to wav, got %s", resp.Format)
+		}
+	}
+}
+
+// Real Gemini TTS returns headerless PCM with mime audio/L16;rate=24000.
+// The router must hand back a playable WAV.
+func TestGeminiRawPCMBecomesWAV(t *testing.T) {
+	pcm := rawPCM(24000)
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		resp := map[string]any{"candidates": []map[string]any{{"content": map[string]any{"parts": []map[string]any{
+			{"inlineData": map[string]any{"mimeType": "audio/L16;codec=pcm;rate=24000", "data": base64.StdEncoding.EncodeToString(pcm)}}}}}}}
+		_ = json.NewEncoder(w).Encode(resp)
+	}))
+	t.Cleanup(srv.Close)
+	r := newRouter(t, nil)
+	add(t, r, "gem", srv.URL+"/generativelanguage.googleapis.com", 1, 0, func(p *types.ProviderConfig) { p.Category = types.CategoryTTS })
+	resp, err := r.Speak(context.Background(), types.SpeakRequest{Text: "hi"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.HasPrefix(resp.Audio, []byte("RIFF")) || resp.ContentType != "audio/wav" || resp.Format != "wav" {
+		t.Fatalf("not a wav: %q ct=%s", resp.Audio[:4], resp.ContentType)
+	}
+	if rate := binary.LittleEndian.Uint32(resp.Audio[24:28]); rate != 24000 {
+		t.Fatalf("sample rate in header = %d", rate)
+	}
+	if !bytes.Equal(resp.Audio[44:], pcm) {
+		t.Fatal("pcm payload changed")
+	}
+	if haveFFmpeg() {
+		resp, err = r.Speak(context.Background(), types.SpeakRequest{Text: "hi", Format: "opus"})
+		if err != nil || resp.Format != "opus" || !bytes.HasPrefix(resp.Audio, []byte("OggS")) {
+			t.Fatalf("opus from raw pcm failed: %v %+v", err, resp)
+		}
+	}
+}
+
+func TestEnsureWAVLeavesRealFilesAlone(t *testing.T) {
+	w := pcmToWAV(rawPCM(10), 16000, 1, 16)
+	if out, ct := ensureWAV(w, "audio/L16;rate=16000"); !bytes.Equal(out, w) || ct != "audio/L16;rate=16000" {
+		t.Fatal("a file that already has a header must not be wrapped again")
+	}
+	if out, _ := ensureWAV([]byte("not audio"), "text/plain"); string(out) != "not audio" {
+		t.Fatal("non-pcm must pass through")
+	}
+}
+
+// Pool-only cap must behave the same for voice and transcription, not only text.
+func TestPoolOnlyCapAppliesToSpeakAndTranscribe(t *testing.T) {
+	pool, _ := fakeTTSProviderOpenAI(t, pcmToWAV(rawPCM(100), 24000, 1, 16))
+	own, _ := fakeTTSProviderOpenAI(t, pcmToWAV(rawPCM(100), 24000, 1, 16))
+	r := newCapRouter(t, 50*time.Millisecond)
+	add(t, r, "pool-tts", pool.URL, 5, 0, func(p *types.ProviderConfig) { p.Category = types.CategoryTTS })
+	ctx := context.Background()
+	if _, _, err := r.CreateTenant(ctx, types.Tenant{ID: "acme", DailyRequestLimit: 1, PoolOnlyCap: true}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := r.AddTenantProvider(ctx, "acme", types.ProviderConfig{Name: "mine-tts", Kind: "openai", BaseURL: own.URL, APIKey: "k", Model: "m", Category: types.CategoryTTS, Priority: 1}); err != nil {
+		t.Fatal(err)
+	}
+	for i := 0; i < 3; i++ { // own key: never counted
+		resp, err := r.Speak(ctx, types.SpeakRequest{TenantID: "acme", Text: "x"})
+		if err != nil || !resp.Own {
+			t.Fatalf("own tts %d: %v %+v", i, err, resp)
+		}
+	}
+	if _, err := r.Speak(ctx, types.SpeakRequest{TenantID: "acme", Text: "x", Provider: "pool-tts"}); err != nil {
+		t.Fatalf("first pool call: %v", err)
+	}
+	var tl *types.TenantLimitError
+	if _, err := r.Speak(ctx, types.SpeakRequest{TenantID: "acme", Text: "x", Provider: "pool-tts"}); !errors.As(err, &tl) {
+		t.Fatalf("second pool call must hit the cap, got %v", err)
+	}
+	if resp, err := r.Speak(ctx, types.SpeakRequest{TenantID: "acme", Text: "x"}); err != nil || !resp.Own {
+		t.Fatalf("capped tenant must still use its own key: %v %+v", err, resp)
+	}
+	// Transcribe: capped tenant without an own STT key is stopped.
+	stt, _ := fakeSTTProvider(t, "hello")
+	add(t, r, "pool-stt", stt.URL, 1, 0, func(p *types.ProviderConfig) { p.Category = types.CategorySTT })
+	if _, err := r.Transcribe(ctx, types.TranscribeRequest{TenantID: "acme", Audio: []byte("x"), Filename: "a.wav"}); !errors.As(err, &tl) {
+		t.Fatalf("capped tenant without own STT key must get the cap error, got %v", err)
+	}
+}
+
+// ffmpeg must never run more than convertSlots at once.
+func TestConvertConcurrencyIsBounded(t *testing.T) {
+	if !haveFFmpeg() {
+		t.Skip("ffmpeg not installed")
+	}
+	if cap(convertSlots) != 4 {
+		t.Fatalf("slots = %d", cap(convertSlots))
+	}
+	wav := pcmToWAV(rawPCM(8000), 16000, 1, 16)
+	done := make(chan error, 12)
+	for i := 0; i < 12; i++ {
+		go func() { _, _, err := convertAudio(context.Background(), wav, "mp3"); done <- err }()
+	}
+	for i := 0; i < 12; i++ {
+		if err := <-done; err != nil && !strings.Contains(err.Error(), "encoder") {
+			t.Fatal(err)
+		}
+	}
+}
diff --git a/pkg/router/cap.go b/pkg/router/cap.go
new file mode 100644
index 0000000..10fa6bf
--- /dev/null
+++ b/pkg/router/cap.go
@@ -0,0 +1,50 @@
+package router
+
+import (
+	"context"
+	"time"
+
+	"github.com/mrmhthegreat/airouter/pkg/types"
+)
+
+// capGate applies a tenant's daily request cap. Generate, Speak and Transcribe
+// all call it so the three behave the same.
+//
+//   - Normal cap: when the cap is used up it returns (false, err) and the
+//     request must stop with that *types.TenantLimitError.
+//   - Pool-only cap (Tenant.PoolOnlyCap): only shared-pool answers count. When
+//     the cap is used up it returns ownOnly=true and capErr set; the caller
+//     keeps going but may only use the tenant's own providers (see onlyOwn).
+func (r *Router) capGate(ctx context.Context, tenant *types.Tenant, start time.Time) (ownOnly bool, capErr *types.TenantLimitError, err error) {
+	if tenant.DailyRequestLimit <= 0 {
+		return false, nil, nil
+	}
+	loc := locFor(tenant.TZ)
+	day := start.In(loc).Format("2006-01-02")
+	usedFn := r.store.TenantDayUsage
+	if tenant.PoolOnlyCap {
+		usedFn = r.store.TenantPoolDayUsage
+	}
+	used, uerr := usedFn(ctx, tenant.ID, day)
+	if uerr != nil || used < tenant.DailyRequestLimit {
+		return false, nil, nil
+	}
+	now := start.In(loc)
+	next := time.Date(now.Year(), now.Month(), now.Day()+1, 0, 0, 0, 0, loc)
+	capErr = &types.TenantLimitError{RetryAfter: next.Sub(now)}
+	if !tenant.PoolOnlyCap {
+		return false, capErr, capErr
+	}
+	return true, capErr, nil
+}
+
+// onlyOwn keeps only the tenant's own providers.
+func onlyOwn(cands []candidate) []candidate {
+	var own []candidate
+	for _, c := range cands {
+		if c.cfg.TenantID != "" {
+			own = append(own, c)
+		}
+	}
+	return own
+}
diff --git a/pkg/router/cap_test.go b/pkg/router/cap_test.go
new file mode 100644
index 0000000..b2e9364
--- /dev/null
+++ b/pkg/router/cap_test.go
@@ -0,0 +1,131 @@
+package router
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	"github.com/mrmhthegreat/airouter/pkg/store"
+	"github.com/mrmhthegreat/airouter/pkg/types"
+)
+
+func newCapRouter(t *testing.T, wait time.Duration) *Router {
+	r, err := New(Options{Store: store.NewMemoryStore(), MaxWait: wait, TenantPolicy: TenantPolicy{AllowCustomBaseURL: true, MaxProviders: 5}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return r
+}
+
+// The cap can be changed at any time, and applies to the next request.
+func TestUpdateTenantCapAppliesImmediately(t *testing.T) {
+	pool, _ := fakeProvider(t, alwaysOK("pool"))
+	r := newCapRouter(t, 100*time.Millisecond)
+	add(t, r, "pool", pool.URL, 1, 0, nil)
+	ctx := context.Background()
+	if _, _, err := r.CreateTenant(ctx, types.Tenant{ID: "acme", DailyRequestLimit: 1}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := gen(r, types.Request{TenantID: "acme"}); err != nil {
+		t.Fatal(err)
+	}
+	var tl *types.TenantLimitError
+	if _, err := gen(r, types.Request{TenantID: "acme"}); !errors.As(err, &tl) {
+		t.Fatalf("want cap error, got %v", err)
+	}
+	if _, err := r.UpdateTenantCap(ctx, "acme", 3, false, false); err != nil { // plan upgrade
+		t.Fatal(err)
+	}
+	if _, err := gen(r, types.Request{TenantID: "acme"}); err != nil {
+		t.Fatalf("raised cap should allow the request: %v", err)
+	}
+	if _, err := r.UpdateTenantCap(ctx, "nobody", 3, false, false); !errors.Is(err, types.ErrUnknownTenant) {
+		t.Fatalf("unknown tenant: %v", err)
+	}
+	if _, err := r.UpdateTenantCap(ctx, "acme", -1, false, false); err == nil {
+		t.Fatal("negative cap must be rejected")
+	}
+	if _, err := r.UpdateTenantCap(ctx, "acme", 3, false, true); err != nil { // disable
+		t.Fatal(err)
+	}
+	if _, err := gen(r, types.Request{TenantID: "acme"}); !errors.Is(err, types.ErrTenantDisabled) {
+		t.Fatalf("disabled tenant: %v", err)
+	}
+}
+
+// With PoolOnlyCap, the tenant's own key is never counted against the cap, and
+// the response says which kind of key answered.
+func TestPoolOnlyCapIgnoresOwnKey(t *testing.T) {
+	pool, _ := fakeProvider(t, alwaysOK("pool"))
+	own, _ := fakeProvider(t, alwaysOK("own"))
+	r := newCapRouter(t, 100*time.Millisecond)
+	add(t, r, "pool", pool.URL, 5, 0, nil) // low priority number = tried first; own has 1
+	ctx := context.Background()
+	if _, _, err := r.CreateTenant(ctx, types.Tenant{ID: "acme", DailyRequestLimit: 1, PoolOnlyCap: true}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := r.AddTenantProvider(ctx, "acme", types.ProviderConfig{Name: "mine", Kind: "openai", BaseURL: own.URL, APIKey: "k", Model: "m", Priority: 1}); err != nil {
+		t.Fatal(err)
+	}
+	for i := 0; i < 4; i++ { // 4 own-key requests, cap is 1
+		resp, err := gen(r, types.Request{TenantID: "acme"})
+		if err != nil {
+			t.Fatalf("own-key request %d blocked: %v", i, err)
+		}
+		if !resp.Own || resp.Provider != "mine" {
+			t.Fatalf("want own key answer, got %+v", resp)
+		}
+	}
+	// Pin the shared pool: this one counts, and the second is capped.
+	resp, err := gen(r, types.Request{TenantID: "acme", Provider: "pool"})
+	if err != nil || resp.Own {
+		t.Fatalf("pool request: %+v %v", resp, err)
+	}
+	var tl *types.TenantLimitError
+	if _, err := gen(r, types.Request{TenantID: "acme", Provider: "pool"}); !errors.As(err, &tl) {
+		t.Fatalf("second pool request should hit the cap, got %v", err)
+	}
+	// Cap reached, but the tenant's own key still answers un-pinned requests.
+	resp, err = gen(r, types.Request{TenantID: "acme"})
+	if err != nil || !resp.Own {
+		t.Fatalf("capped tenant should fall back to its own key: %+v %v", resp, err)
+	}
+}
+
+// A capped tenant with no key of its own gets the cap error, not a pool answer.
+func TestCappedTenantWithoutOwnKeyIsStopped(t *testing.T) {
+	pool, _ := fakeProvider(t, alwaysOK("pool"))
+	r := newCapRouter(t, 100*time.Millisecond)
+	add(t, r, "pool", pool.URL, 1, 0, nil)
+	ctx := context.Background()
+	if _, _, err := r.CreateTenant(ctx, types.Tenant{ID: "acme", DailyRequestLimit: 1, PoolOnlyCap: true}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := gen(r, types.Request{TenantID: "acme"}); err != nil {
+		t.Fatal(err)
+	}
+	var tl *types.TenantLimitError
+	if _, err := gen(r, types.Request{TenantID: "acme"}); !errors.As(err, &tl) {
+		t.Fatalf("want cap error, got %v", err)
+	}
+}
+
+// A per-request MaxWait overrides the router default.
+func TestRequestMaxWaitOverridesDefault(t *testing.T) {
+	a, _ := fakeProvider(t, alwaysOK("x"))
+	r := newCapRouter(t, 5*time.Second) // long default
+	add(t, r, "a", a.URL, 1, 0, func(p *types.ProviderConfig) { p.RPM = 1 })
+	if _, err := gen(r, types.Request{}); err != nil {
+		t.Fatal(err)
+	}
+	start := time.Now()
+	var ex *types.ExhaustedError
+	_, err := gen(r, types.Request{MaxWait: 50 * time.Millisecond})
+	if !errors.As(err, &ex) {
+		t.Fatalf("want ExhaustedError, got %v", err)
+	}
+	if time.Since(start) > time.Second {
+		t.Fatalf("waited %v despite MaxWait 50ms", time.Since(start))
+	}
+}
