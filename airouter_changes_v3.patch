+	// OpenAI-compatible speech route carries the voice too
+	if c, _, raw := do(t, srv, "POST", "/v1/audio/speech", keys["bob"], `{"model":"auto","input":"hi","voice":"AliceVoice"}`); c != 404 {
+		t.Fatalf("openai route leaked the voice: %d %s", c, raw)
