+// One tenant must never see, use, or delete another tenant's cloned voice, even
+// when both clone inside the same shared ElevenLabs account.
+func TestVoiceIsolationBetweenTenants(t *testing.T) {
+	shared := newFakeEL(t)
+	r := newELRouter(t, TenantPolicy{AllowSharedVoiceClone: true, AllowCustomBaseURL: true})
+	addEL(t, r, "el-shared", shared, "shared-key", nil)
+	ctx := context.Background()
+	for _, id := range []string{"alice", "bob"} {
+		if _, _, err := r.CreateTenant(ctx, types.Tenant{ID: id}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	av, err := r.CloneVoice(ctx, types.CloneVoiceRequest{TenantID: "alice", Name: "AliceVoice", Samples: sampleFiles(), ConsentConfirmed: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	// bob: cannot list, speak (by id or by name), or delete it
+	bl, err := r.ListVoices(ctx, "bob", ListVoicesOptions{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, v := range bl {
+		if v.ID == av.ID || v.Name == "AliceVoice" {
+			t.Fatal("bob can see alice's voice")
+		}
+	}
+	for _, who := range []string{av.ID, "AliceVoice", "alicevoice"} {
+		if _, err := r.Speak(ctx, types.SpeakRequest{TenantID: "bob", Text: "hi", Voice: who}); !errors.Is(err, types.ErrVoiceNotFound) {
+			t.Fatalf("bob speaking with %q: want ErrVoiceNotFound, got %v", who, err)
+		}
+	}
+	if err := r.DeleteVoice(ctx, "bob", av.ID); !errors.Is(err, types.ErrVoiceNotFound) {
+		t.Fatalf("bob deleting alice's voice: %v", err)
+	}
+	if shared.hit("delete") != 0 {
+		t.Fatal("alice's voice was deleted at ElevenLabs by bob")
+	}
+	// alice still can
+	if _, err := r.Speak(ctx, types.SpeakRequest{TenantID: "alice", Text: "hi", Voice: "AliceVoice"}); err != nil {
+		t.Fatal(err)
+	}
+	if al, _ := r.ListVoices(ctx, "alice", ListVoicesOptions{}); len(al) != 3 {
+		t.Fatalf("alice should see 2 premade + her own, got %d", len(al))
+	}
+	// both see the ready-made voices
+	if _, err := r.Speak(ctx, types.SpeakRequest{TenantID: "bob", Text: "hi", Voice: "Rachel"}); err != nil {
+		t.Fatal(err)
+	}
+}
+
+// Without its own ElevenLabs key a tenant cannot burn the operator's voice slots;
+// with its own key it clones in its OWN account and the shared account is untouched.
+func TestTenantClonesOnlyWithOwnKey(t *testing.T) {
+	shared, mine := newFakeEL(t), newFakeEL(t)
+	r := newELRouter(t, TenantPolicy{AllowCustomBaseURL: true}) // AllowSharedVoiceClone stays false
+	addEL(t, r, "el-shared", shared, "shared-key", nil)
+	ctx := context.Background()
+	if _, _, err := r.CreateTenant(ctx, types.Tenant{ID: "carol"}); err != nil {
+		t.Fatal(err)
+	}
+	req := types.CloneVoiceRequest{TenantID: "carol", Name: "Carol", Samples: sampleFiles(), ConsentConfirmed: true}
+	if _, err := r.CloneVoice(ctx, req); !errors.Is(err, types.ErrVoiceCloneNotAllowed) {
+		t.Fatalf("want ErrVoiceCloneNotAllowed, got %v", err)
+	}
+	if shared.hit("clone") != 0 {
+		t.Fatal("clone reached the shared account")
+	}
+	if _, err := r.AddTenantProvider(ctx, "carol", types.ProviderConfig{Name: "carol-el", Kind: "openai", BaseURL: mine.URL(), APIKey: "carol-key",
+		Model: "eleven_multilingual_v2", Category: types.CategoryTTS, Priority: 1}); err != nil {
+		t.Fatal(err)
+	}
+	v, err := r.CloneVoice(ctx, req)
+	if err != nil || !v.Own {
+		t.Fatalf("clone with own key: %v %+v", err, v)
+	}
+	if mine.hit("clone") != 1 || shared.hit("clone") != 0 {
+		t.Fatal("clone must go to carol's own account only")
+	}
+	// her clone only exists in her account, so failover must not send it to the shared one
+	resp, err := r.Speak(ctx, types.SpeakRequest{TenantID: "carol", Text: "hi", Voice: "Carol"})
+	if err != nil || !resp.Own {
+		t.Fatalf("speak with clone: %v %+v", err, resp)
+	}
+	if shared.hit("tts") != 0 {
+		t.Fatal("a cloned voice was sent to a different ElevenLabs account")
+	}
+	// per-tenant clone limit
+	r2 := newELRouter(t, TenantPolicy{MaxClonedVoices: 1})
+	addEL(t, r2, "el", shared, "k", nil)
+	if _, err := r2.CloneVoice(ctx, types.CloneVoiceRequest{Name: "One", Samples: sampleFiles(), ConsentConfirmed: true}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := r2.CloneVoice(ctx, types.CloneVoiceRequest{Name: "Two", Samples: sampleFiles(), ConsentConfirmed: true}); !errors.Is(err, types.ErrBadRequest) {
+		t.Fatalf("clone limit not enforced: %v", err)
+	}
+}
+
+func TestElevenLabsTranscribe(t *testing.T) {
+	f := newFakeEL(t)
+	r := newELRouter(t, TenantPolicy{})
+	add(t, r, "el-stt", f.URL(), 1, 0, func(p *types.ProviderConfig) { p.Category = types.CategorySTT; p.Model = "scribe_v1" })
+	resp, err := r.Transcribe(context.Background(), types.TranscribeRequest{Audio: []byte("abc"), Filename: "a.mp3", Language: "en"})
+	if err != nil || !strings.Contains(resp.Text, "scribe_v1") || resp.Language != "en" {
+		t.Fatalf("%v %+v", err, resp)
+	}
+}
+
+func TestListVoicesWithoutElevenLabsExplainsHowToAdd(t *testing.T) {
+	r := newELRouter(t, TenantPolicy{})
+	if _, err := r.ListVoices(context.Background(), "", ListVoicesOptions{}); err == nil || !strings.Contains(err.Error(), "provider add -preset elevenlabs") {
+		t.Fatalf("got %v", err)
+	}
+}
+
+var _ = io.EOF
+
+// A voice the operator (default tenant) clones is shared: every tenant can list
+// and speak it, but cannot delete it. A tenant's own clone stays private.
+func TestOperatorVoiceSharingIsOptIn(t *testing.T) {
+	f := newFakeEL(t)
+	r := newELRouter(t, TenantPolicy{AllowCustomBaseURL: true})
+	addEL(t, r, "el-shared", f, "shared-key", nil)
+	ctx := context.Background()
+	if _, _, err := r.CreateTenant(ctx, types.Tenant{ID: "bob"}); err != nil {
+		t.Fatal(err)
+	}
+	sv, err := r.CloneVoice(ctx, types.CloneVoiceRequest{TenantID: types.DefaultTenantID, Name: "HouseVoice", Samples: sampleFiles(), ConsentConfirmed: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	sees := func() bool {
+		list, err := r.ListVoices(ctx, "bob", ListVoicesOptions{})
+		if err != nil {
+			t.Fatal(err)
+		}
+		for _, v := range list {
+			if v.ID == sv.ID {
+				return true
+			}
+		}
+		return false
+	}
+	// Private by default: bob neither sees nor speaks it.
+	if sees() {
+		t.Fatal("a new operator voice must be private")
+	}
+	if _, err := r.Speak(ctx, types.SpeakRequest{TenantID: "bob", Text: "hi", Voice: sv.ID}); err == nil {
+		t.Fatal("bob spoke a private operator voice")
+	}
+	if err := r.ShareVoice(ctx, "bob", sv.ID, true); err == nil {
+		t.Fatal("a tenant must not share the operator's voice")
+	}
+	if err := r.ShareVoice(ctx, types.DefaultTenantID, sv.ID, true); err != nil {
+		t.Fatal(err)
+	}
+	if !sees() {
+		t.Fatal("bob should see the shared operator voice")
+	}
+	for _, who := range []string{sv.ID, "HouseVoice"} {
+		if _, err := r.Speak(ctx, types.SpeakRequest{TenantID: "bob", Text: "hi", Voice: who}); err != nil {
+			t.Fatalf("bob speaking with %q: %v", who, err)
+		}
+	}
+	if err := r.DeleteVoice(ctx, "bob", sv.ID); !errors.Is(err, types.ErrVoiceNotFound) {
+		t.Fatalf("bob must not delete the shared voice: %v", err)
+	}
+	if f.hit("delete") != 0 {
+		t.Fatal("shared voice was deleted at ElevenLabs by a tenant")
+	}
+	// Unshare: hidden again.
+	if err := r.ShareVoice(ctx, types.DefaultTenantID, sv.ID, false); err != nil {
+		t.Fatal(err)
+	}
+	if sees() {
+		t.Fatal("unshared voice is still visible")
+	}
+	if _, err := r.Speak(ctx, types.SpeakRequest{TenantID: "bob", Text: "hi", Voice: sv.ID}); err == nil {
+		t.Fatal("bob spoke an unshared voice")
+	}
+}
diff --git a/pkg/router/embed.go b/pkg/router/embed.go
new file mode 100644
index 0000000..c1b0163
--- /dev/null
+++ b/pkg/router/embed.go
@@ -0,0 +1,265 @@
+package router
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+	"time"
+
+	"github.com/mrmhthegreat/airouter/pkg/types"
+)
+
+const (
+	// embedBatchSize is how many texts go to a provider in one HTTP request. A
+	// longer list is split into several requests to the SAME provider, so all
+	// vectors of one call always come from one model.
+	embedBatchSize = 100
+	// maxEmbedTexts caps one Embed call. Send big corpora in several calls.
+	maxEmbedTexts = 2000
+)
+
+// Embed turns texts into embedding vectors. It picks an embedding-capable
+// provider (category="embed"), calls the OpenAI-compatible {base}/embeddings
+// endpoint, and on failure fails over to the next provider, like Generate. The
+// tenant's daily cap and own-key rules apply as for chat.
+//
+// IMPORTANT for vector search: vectors from different models (or of different
+// sizes) cannot be compared. Failover can switch models in the middle of your
+// data, so either configure ONE embedding model, pin it with
+// EmbedRequest.Provider, or set EmbedRequest.Dimensions so a provider that
+// answers with another size is skipped. Store EmbedResponse.Model and
+// .Dimensions with your index.
+func (r *Router) Embed(ctx context.Context, req types.EmbedRequest) (*types.EmbedResponse, error) {
+	start := r.now()
+	if req.TenantID == "" {
+		req.TenantID = types.DefaultTenantID
+	}
+	if len(req.Texts) == 0 {
+		return nil, fmt.Errorf("%w: EmbedRequest.Texts is required", types.ErrBadRequest)
+	}
+	if len(req.Texts) > maxEmbedTexts {
+		return nil, fmt.Errorf("%w: at most %d texts per call (got %d); send them in several calls", types.ErrBadRequest, maxEmbedTexts, len(req.Texts))
+	}
+	if req.Dimensions < 0 {
+		return nil, fmt.Errorf("%w: Dimensions must be 0 or more", types.ErrBadRequest)
+	}
+	chars := 0
+	for i, t := range req.Texts {
+		if strings.TrimSpace(t) == "" { // providers answer 400 for an empty input and the whole batch is lost
+			return nil, fmt.Errorf("%w: text %d is empty", types.ErrBadRequest, i)
+		}
+		chars += len(t)
+	}
+	tokens := chars/4 + len(req.Texts) // rough estimate: ~4 characters per token
+
+	tenant, err := r.store.TenantByID(ctx, req.TenantID)
+	if err != nil {
+		return nil, err
+	}
+	if tenant == nil {
+		return nil, types.ErrUnknownTenant
+	}
+	if tenant.Disabled {
+		return nil, types.ErrTenantDisabled
+	}
+	ownOnly, capErr, err := r.capGate(ctx, tenant, start)
+	if err != nil {
+		return nil, err
+	}
+	cands := r.candidates(ctx, types.Request{TenantID: req.TenantID, Provider: req.Provider, Category: types.CategoryEmbed})
+	if ownOnly {
+		if cands = onlyOwn(cands); len(cands) == 0 {
+			return nil, capErr
+		}
+	}
+	if len(cands) == 0 {
+		return nil, errors.New("airouter: no embedding providers configured (add a provider with category \"embed\")")
+	}
+	if r.requestTimeout > 0 {
+		var cancel context.CancelFunc
+		ctx, cancel = context.WithTimeout(ctx, r.requestTimeout)
+		defer cancel()
+	}
+
+	var attempts []types.Attempt
+	failed := map[int64]bool{}
+	wait := r.maxWait
+	if req.MaxWait > 0 {
+		wait = req.MaxWait
+	}
+	deadline := start.Add(wait)
+	for {
+		now := r.now()
+		var picked *candidate
+		minWait := time.Duration(1<<62 - 1)
+		reasons := map[string]string{}
+		remaining := 0
+		for i := range cands {
+			c := &cands[i]
+			if failed[c.cfg.ID] {
+				continue
+			}
+			remaining++
+			if !c.cfg.HasKey() {
+				reasons[c.cfg.Name] = "no API key (set $" + c.cfg.APIKeyEnv + ")"
+				continue
+			}
+			ok, w, _, why := r.acquire(ctx, c.cfg, c.state, now)
+			if ok {
+				picked = c
+				break
+			}
+			reasons[c.cfg.Name] = why
+			if w < minWait {
+				minWait = w
+			}
+		}
+		if picked == nil {
+			if remaining == 0 && len(attempts) > 0 { // every provider was tried and failed
+				return nil, r.allFailed(attempts)
+			}
+			if now.Add(minWait).After(deadline) || ctx.Err() != nil {
+				if ctx.Err() != nil {
+					return nil, ctx.Err()
+				}
+				if minWait == time.Duration(1<<62-1) {
+					minWait = time.Hour
+				}
+				return nil, &types.ExhaustedError{RetryAfter: minWait, Reasons: reasons}
+			}
+			select {
+			case <-time.After(minWait + 20*time.Millisecond):
+			case <-ctx.Done():
+				return nil, ctx.Err()
+			}
+			continue
+		}
+
+		vecs, hdr, err := r.callEmbed(ctx, picked.cfg, req.Texts, req.Dimensions)
+		if err == nil {
+			err = checkEmbedDims(vecs, req.Dimensions)
+		}
+		picked.state.release(tokens)
+		if hdr != nil {
+			r.observe(ctx, picked, hdr, r.now())
+		}
+		errs := 0
+		if err != nil {
+			errs = 1
+		}
+		_ = r.store.AddUsage(ctx, req.TenantID, picked.cfg.ID, dayOf(picked.cfg, now), 1, tokens, errs)
+		if err == nil {
+			return &types.EmbedResponse{
+				Vectors: vecs, Dimensions: len(vecs[0]), Tokens: tokens, Provider: picked.cfg.Name, Model: picked.cfg.Model,
+				Own: picked.cfg.TenantID != "", LatencyMS: r.now().Sub(start).Milliseconds(), Attempts: attempts,
+			}, nil
+		}
+		if ctx.Err() != nil {
+			return nil, ctx.Err()
+		}
+		f := r.classify(ctx, picked, err)
+		attempts = append(attempts, types.Attempt{Provider: picked.cfg.Name, Error: err.Error(), Status: f.status, Kind: f.kind})
+		failed[picked.cfg.ID] = true
+	}
+}
+
+// checkEmbedDims makes sure every vector has the same size, and the requested
+// one when Dimensions was set. A mismatch is an unusable answer: the provider is
+// skipped for this call without being punished.
+func checkEmbedDims(vecs [][]float32, want int) error {
+	if len(vecs) == 0 {
+		return errBadResponse("embeddings: no vectors in response")
+	}
+	n := len(vecs[0])
+	for i, v := range vecs {
+		if len(v) != n {
+			return errBadResponse(fmt.Sprintf("embeddings: vector %d has %d numbers, vector 0 has %d", i, len(v), n))
+		}
+	}
+	if want > 0 && n != want {
+		return errBadResponse(fmt.Sprintf("embeddings: provider returned %d dimensions, %d requested", n, want))
+	}
+	return nil
+}
+
+// callEmbed posts {model, input:[...]} to {base}/embeddings, in batches of
+// embedBatchSize to the same provider, and returns the vectors in input order.
+func (r *Router) callEmbed(ctx context.Context, p types.ProviderConfig, texts []string, dimensions int) ([][]float32, http.Header, error) {
+	out := make([][]float32, 0, len(texts))
+	var hdr http.Header
+	for from := 0; from < len(texts); from += embedBatchSize {
+		to := from + embedBatchSize
+		if to > len(texts) {
+			to = len(texts)
+		}
+		vecs, h, err := r.callEmbedBatch(ctx, p, texts[from:to], dimensions)
+		if h != nil {
+			hdr = h
+		}
+		if err != nil {
+			return nil, hdr, err
+		}
+		out = append(out, vecs...)
+	}
+	return out, hdr, nil
+}
+
+func (r *Router) callEmbedBatch(ctx context.Context, p types.ProviderConfig, texts []string, dimensions int) ([][]float32, http.Header, error) {
+	reqBody := map[string]any{"model": p.Model, "input": texts}
+	if dimensions > 0 {
+		reqBody["dimensions"] = dimensions
+	}
+	body, err := json.Marshal(reqBody)
+	if err != nil {
+		return nil, nil, err
+	}
+	callCtx, cancel := context.WithTimeout(ctx, 30*time.Second)
+	defer cancel()
+	httpReq, err := http.NewRequestWithContext(callCtx, http.MethodPost, p.BaseURL+"/embeddings", bytes.NewReader(body))
+	if err != nil {
+		return nil, nil, err
+	}
+	httpReq.Header.Set("Content-Type", "application/json")
+	if k := p.ResolveKey(); k != "" {
+		httpReq.Header.Set("Authorization", "Bearer "+k)
+	}
+	resp, err := r.client.Do(httpReq)
+	if err != nil {
+		return nil, nil, err
+	}
+	defer resp.Body.Close()
+	data, _ := io.ReadAll(io.LimitReader(resp.Body, 32<<20))
+	if resp.StatusCode/100 != 2 {
+		ra, _ := atoiSafe(resp.Header.Get("Retry-After"))
+		return nil, resp.Header, &types.HTTPError{Code: resp.StatusCode, Body: string(data), RetryAfter: time.Duration(ra) * time.Second, Header: resp.Header}
+	}
+	var parsed struct {
+		Data []struct {
+			Index     int       `json:"index"`
+			Embedding []float32 `json:"embedding"`
+		} `json:"data"`
+	}
+	if err := json.Unmarshal(data, &parsed); err != nil {
+		return nil, resp.Header, errBadResponse("bad embeddings response: " + types.Truncate(string(data), 200))
+	}
+	if len(parsed.Data) != len(texts) {
+		return nil, resp.Header, errBadResponse(fmt.Sprintf("embeddings: got %d vectors for %d texts", len(parsed.Data), len(texts)))
+	}
+	vecs := make([][]float32, len(texts))
+	for i, d := range parsed.Data {
+		idx := d.Index
+		if idx < 0 || idx >= len(vecs) || vecs[idx] != nil { // no usable index: keep response order
+			idx = i
+		}
+		if len(d.Embedding) == 0 {
+			return nil, resp.Header, errBadResponse("embeddings: empty vector in response")
+		}
+		vecs[idx] = d.Embedding
+	}
+	return vecs, resp.Header, nil
+}
diff --git a/pkg/router/embed_fix_test.go b/pkg/router/embed_fix_test.go
new file mode 100644
index 0000000..467b242
--- /dev/null
+++ b/pkg/router/embed_fix_test.go
@@ -0,0 +1,275 @@
+package router
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"sync"
+	"sync/atomic"
+	"testing"
+
+	"github.com/mrmhthegreat/airouter/pkg/store"
+	"github.com/mrmhthegreat/airouter/pkg/types"
+)
+
+// dimServer answers /embeddings with vectors of `dim` numbers (value = input
+// position) and records every request it gets.
+type dimServer struct {
+	*httptest.Server
+	mu     sync.Mutex
+	sizes  []int // number of inputs per request
+	dimReq []int // "dimensions" value received per request
+}
+
+func newDimServer(t *testing.T, dim, status int) *dimServer {
+	d := &dimServer{}
+	d.Server = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		var b struct {
+			Input      []string `json:"input"`
+			Dimensions int      `json:"dimensions"`
+		}
+		_ = json.NewDecoder(r.Body).Decode(&b)
+		d.mu.Lock()
+		d.sizes = append(d.sizes, len(b.Input))
+		d.dimReq = append(d.dimReq, b.Dimensions)
+		d.mu.Unlock()
+		if status != 200 {
+			http.Error(w, `{"error":"nope"}`, status)
+			return
+		}
+		type it struct {
+			Index     int       `json:"index"`
+			Embedding []float32 `json:"embedding"`
+		}
+		var out struct {
+			Data []it `json:"data"`
+		}
+		for i, text := range b.Input {
+			v := make([]float32, dim)
+			v[0] = float32(len(text)) // lets a test see which text became which vector
+			out.Data = append(out.Data, it{i, v})
+		}
+		_ = json.NewEncoder(w).Encode(out)
+	}))
+	t.Cleanup(d.Close)
+	return d
+}
+
+func (d *dimServer) calls() int { d.mu.Lock(); defer d.mu.Unlock(); return len(d.sizes) }
+
+func TestEmbedRejectsBadInputBeforeCallingAnyone(t *testing.T) {
+	srv := newDimServer(t, 4, 200)
+	r := newRouter(t, nil)
+	add(t, r, "e", srv.URL, 1, 0, embedMod)
+	ctx := context.Background()
+	for name, texts := range map[string][]string{"blank": {"ok", "   "}, "empty string": {""}} {
+		if _, err := r.Embed(ctx, types.EmbedRequest{Texts: texts}); !errors.Is(err, types.ErrBadRequest) {
+			t.Errorf("%s: want ErrBadRequest, got %v", name, err)
+		}
+	}
+	many := make([]string, maxEmbedTexts+1)
+	for i := range many {
+		many[i] = "x"
+	}
+	if _, err := r.Embed(ctx, types.EmbedRequest{Texts: many}); !errors.Is(err, types.ErrBadRequest) {
+		t.Errorf("too many texts: %v", err)
+	}
+	if srv.calls() != 0 {
+		t.Fatalf("provider was called %d times for invalid input", srv.calls())
+	}
+}
+
+// A long list is split into batches to the SAME provider and comes back in order.
+func TestEmbedBatchesToOneProviderInOrder(t *testing.T) {
+	srv := newDimServer(t, 4, 200)
+	r := newRouter(t, nil)
+	add(t, r, "e", srv.URL, 1, 0, embedMod)
+	texts := make([]string, 250)
+	for i := range texts {
+		texts[i] = string(make([]byte, i+1)) // text i has length i+1
+		texts[i] = fmt.Sprintf("%0*d", i%50+1, 0)
+	}
+	resp, err := r.Embed(context.Background(), types.EmbedRequest{Texts: texts})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(resp.Vectors) != 250 || resp.Dimensions != 4 || resp.Tokens <= 0 {
+		t.Fatalf("resp: %d vectors, dim %d, tokens %d", len(resp.Vectors), resp.Dimensions, resp.Tokens)
+	}
+	if fmt.Sprint(srv.sizes) != "[100 100 50]" {
+		t.Fatalf("batches = %v, want [100 100 50]", srv.sizes)
+	}
+	for i, v := range resp.Vectors {
+		if int(v[0]) != len(texts[i]) {
+			t.Fatalf("vector %d belongs to another text", i)
+		}
+	}
+}
+
+// If a later batch fails, the whole call moves to the next provider, so one call
+// never returns vectors from two different models.
+func TestEmbedNeverMixesModelsWithinOneCall(t *testing.T) {
+	var n atomic.Int64
+	flaky := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if n.Add(1) >= 2 { // first batch fine, second batch fails
+			http.Error(w, "boom", 500)
+			return
+		}
+		var b struct{ Input []string }
+		_ = json.NewDecoder(r.Body).Decode(&b)
+		out := `{"data":[`
+		for i := range b.Input {
+			if i > 0 {
+				out += ","
+			}
+			out += fmt.Sprintf(`{"index":%d,"embedding":[1,1,1]}`, i)
+		}
+		_, _ = w.Write([]byte(out + `]}`))
+	}))
+	t.Cleanup(flaky.Close)
+	good := newDimServer(t, 3, 200)
+	r := newRouter(t, nil)
+	add(t, r, "flaky", flaky.URL, 1, 0, embedMod)
+	add(t, r, "good", good.URL, 2, 0, embedMod)
+	texts := make([]string, 150)
+	for i := range texts {
+		texts[i] = "t"
+	}
+	resp, err := r.Embed(context.Background(), types.EmbedRequest{Texts: texts})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if resp.Provider != "good" || len(resp.Attempts) != 1 || resp.Attempts[0].Kind == "" {
+		t.Fatalf("expected failover to 'good' with a classified attempt: %+v", resp)
+	}
+	for _, v := range resp.Vectors {
+		if v[1] != 0 { // 'good' vectors are [len,0,0]; 'flaky' ones are [1,1,1]
+			t.Fatal("vectors from two providers were mixed")
+		}
+	}
+}
+
+func TestEmbedDimensionsAreEnforcedAndSkippedWithoutPenalty(t *testing.T) {
+	big := newDimServer(t, 3072, 200) // ignores the dimensions parameter
+	small := newDimServer(t, 768, 200)
+	r := newRouter(t, nil)
+	add(t, r, "gem3072", big.URL, 1, 0, embedMod)
+	add(t, r, "other768", small.URL, 2, 0, embedMod)
+	ctx := context.Background()
+	resp, err := r.Embed(ctx, types.EmbedRequest{Texts: []string{"a"}, Dimensions: 768})
+	if err != nil || resp.Provider != "other768" || resp.Dimensions != 768 {
+		t.Fatalf("want other768/768, got err=%v", err)
+	}
+	if big.dimReq[0] != 768 || small.dimReq[0] != 768 {
+		t.Fatalf("the dimensions parameter was not sent: %v %v", big.dimReq, small.dimReq)
+	}
+	// the mismatch is a bad answer, not an outage: gem3072 is still usable when no size is asked
+	resp, err = r.Embed(ctx, types.EmbedRequest{Texts: []string{"a"}})
+	if err != nil || resp.Provider != "gem3072" || resp.Dimensions != 3072 {
+		t.Fatalf("provider with a wrong size was punished: err=%v", err)
+	}
+	// nobody can give 1536: clear error, not "limited, retry in 1h"
+	_, err = r.Embed(ctx, types.EmbedRequest{Texts: []string{"a"}, Dimensions: 1536})
+	var af *types.AllFailedError
+	if !errors.As(err, &af) || len(af.Attempts) != 2 {
+		t.Fatalf("want AllFailedError with 2 attempts, got %v", err)
+	}
+}
+
+// "Every provider failed" must say why, instead of claiming the providers are
+// limited for an hour. Same for speech and transcription.
+func TestEveryAudioAndEmbedPathReportsRealFailure(t *testing.T) {
+	ctx := context.Background()
+	for _, tc := range []struct {
+		status   int
+		wantBad  bool
+		wantKind string
+	}{{400, true, kindBadRequest}, {500, false, kindTransient}} {
+		srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) { http.Error(w, "x", tc.status) }))
+		defer srv.Close()
+		check := func(name string, err error) {
+			t.Helper()
+			var br *types.BadRequestError
+			var af *types.AllFailedError
+			var ex *types.ExhaustedError
+			switch {
+			case errors.As(err, &ex):
+				t.Errorf("%s/%d: reported as 'limited, retry later': %v", name, tc.status, err)
+			case tc.wantBad && !errors.As(err, &br):
+				t.Errorf("%s/%d: want BadRequestError, got %v", name, tc.status, err)
+			case !tc.wantBad && !errors.As(err, &af):
+				t.Errorf("%s/%d: want AllFailedError, got %v", name, tc.status, err)
+			}
+			var atts []types.Attempt
+			if br != nil {
+				atts = br.Attempts
+			} else if af != nil {
+				atts = af.Attempts
+			}
+			if len(atts) != 1 || atts[0].Kind != tc.wantKind || atts[0].Status != tc.status {
+				t.Errorf("%s/%d: attempt lacks status/kind: %+v", name, tc.status, atts)
+			}
+		}
+		re := newRouter(t, nil)
+		add(t, re, "e", srv.URL, 1, 0, embedMod)
+		_, err := re.Embed(ctx, types.EmbedRequest{Texts: []string{"a"}})
+		check("embed", err)
+
+		rs := newRouter(t, nil)
+		add(t, rs, "s", srv.URL, 1, 0, func(p *types.ProviderConfig) { p.Category = types.CategoryTTS })
+		_, err = rs.Speak(ctx, types.SpeakRequest{Text: "hi"})
+		check("speak", err)
+
+		rt := newRouter(t, nil)
+		add(t, rt, "t", srv.URL, 1, 0, func(p *types.ProviderConfig) { p.Category = types.CategorySTT })
+		_, err = rt.Transcribe(ctx, types.TranscribeRequest{Audio: []byte("x"), Filename: "a.wav"})
+		check("transcribe", err)
+	}
+}
+
+// own_requests_today must count what the tenant's own models SERVED, and must not
+// be inflated by failed attempts on the shared pool.
+func TestOverviewOwnAndPoolCountsIgnoreFailures(t *testing.T) {
+	r, _ := New(Options{Store: store.NewMemoryStore(), TenantPolicy: TenantPolicy{AllowCustomBaseURL: true}})
+	ctx := context.Background()
+	add(t, r, "pool", "http://x", 1, 0, nil)
+	if _, _, err := r.CreateTenant(ctx, types.Tenant{ID: "acme", DailyRequestLimit: 100, PoolOnlyCap: true}); err != nil {
+		t.Fatal(err)
+	}
+	own, err := r.AddTenantProvider(ctx, "acme", types.ProviderConfig{Name: "mine", Kind: "openai", BaseURL: "http://y", APIKey: "k", Model: "m"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var poolID int64
+	for _, s := range r.Status(ctx, "acme") {
+		if s.Name == "pool" {
+			poolID = s.ID
+		}
+	}
+	day := r.now().UTC().Format("2006-01-02")
+	_ = r.Store().AddUsage(ctx, "acme", poolID, day, 5, 0, 2) // 5 attempts, 2 failed: 3 served
+	_ = r.Store().AddUsage(ctx, "acme", own.ID, day, 4, 0, 1) // 4 attempts, 1 failed: 3 served
+	ov, err := r.TenantOverview(ctx, "acme")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if ov.Cap.Used != 3 || ov.Cap.PoolToday != 3 || ov.Cap.OwnToday != 3 {
+		t.Fatalf("used=%d pool=%d own=%d, want 3/3/3", ov.Cap.Used, ov.Cap.PoolToday, ov.Cap.OwnToday)
+	}
+}
+
+func TestEmbedTokensAreRecorded(t *testing.T) {
+	srv := newDimServer(t, 2, 200)
+	r := newRouter(t, nil)
+	add(t, r, "e", srv.URL, 1, 0, embedMod)
+	if _, err := r.Embed(context.Background(), types.EmbedRequest{Texts: []string{"hello world, this is a sentence"}}); err != nil {
+		t.Fatal(err)
+	}
+	u, err := r.Usage(context.Background(), types.DefaultTenantID, "")
+	if err != nil || u.TokensToday <= 0 {
+		t.Fatalf("tokens not recorded: %v %+v", err, u)
+	}
+}
