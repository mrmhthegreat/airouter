# Example environment variables for airouter.
# Copy to .env and fill in the keys you actually have, then `source .env`.
# airouter only stores the NAMES of these variables in its DB, never the values.

# Free-tier keys — get them from each provider's console.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
SAMBANOVA_API_KEY=
OPENAI_API_KEY=

# Optional: a different Ollama endpoint (default is http://localhost:11434).
# OLLAMA_HOST=http://localhost:11434

# Admin token for the HTTP server's admin endpoints.
# Without it, /v1/providers, /v1/tenants, /v1/bootstrap are disabled.
AIROUTER_ADMIN_TOKEN=change-me

# Database file location (default: ./airouter.db).
# AIROUTER_DB=/var/lib/airouter/airouter.db
