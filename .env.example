# Example environment variables for airouter.
# Copy to .env and fill in the keys you actually have, then `source .env`.
# Env vars are optional: you can instead store keys encrypted in the DB with
#   airouter provider set-key ID     or     airouter bootstrap -store-keys
# When a provider uses an env var, only its NAME is stored in the DB.

# Free-tier keys — get them from each provider's console.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
SAMBANOVA_API_KEY=
OPENAI_API_KEY=

# Optional: a different Ollama endpoint (default is http://localhost:11434).
# OLLAMA_HOST=http://localhost:11434

# Admin token for the HTTP server's admin endpoints.
# Without it, /v1/providers, /v1/tenants, /v1/bootstrap are disabled.
AIROUTER_ADMIN_TOKEN=change-me

# Database file location (default: ./airouter.db).
# AIROUTER_DB=/var/lib/airouter/airouter.db

# Secret that encrypts provider API keys stored in the DB (AES-256-GCM).
# Generate with: openssl rand -hex 32   — keep it OUT of your DB backups.
# If unset, a random key file <db>.key (mode 0600) is created next to the DB.
# AIROUTER_SECRET=

# Browser origins allowed to call the API (comma-separated, or *). Default: off.
# AIROUTER_CORS=https://myapp.example.com
